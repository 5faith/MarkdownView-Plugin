{
  "name": "markdownview-plugin",
  "packageManager": "pnpm@10.33.2",
  "displayName": "MarkdownView",
  "description": "A Milkdown-powered Markdown WYSIWYG editor for VS Code.",
  "version": "0.1.0",
  "publisher": "5faith",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/5faith/MarkdownView-Plugin.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCustomEditor:markdownView.editor",
    "onCommand:markdownView.openEditor"
  ],
  "contributes": {
    "commands": [
      {
        "command": "markdownView.openEditor",
        "title": "MarkdownView: Open WYSIWYG Editor"
      }
    ],
    "customEditors": [
      {
        "viewType": "markdownView.editor",
        "displayName": "MarkdownView",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "MarkdownView",
      "properties": {
        "markdownView.fontSize": {
          "type": "number",
          "default": 14,
          "minimum": 10,
          "maximum": 32,
          "description": "Font size in pixels for the MarkdownView editor."
        }
      }
    }
  },
  "scripts": {
    "dev": "pnpm run compile && vsce package --no-dependencies --out markdownview-dev.vsix && code --user-data-dir=.vscode-test/local-user-data --extensions-dir=.vscode-test/local-extensions --install-extension markdownview-dev.vsix --force && code --user-data-dir=.vscode-test/local-user-data --extensions-dir=.vscode-test/local-extensions --new-window examples/local-test.md",
    "compile": "node esbuild.cjs",
    "watch": "node esbuild.cjs --watch",
    "check": "tsc --noEmit",
    "package": "pnpm run compile && vsce package --no-dependencies"
  },
  "dependencies": {
    "@codemirror/view": "^6.43.15",
    "@milkdown/crepe": "7.22.3",
    "@milkdown/kit": "7.22.3",
    "@xz-summer/milkdown-container": "0.1.10",
    "mermaid": "^11.17.2",
    "remark-definition-list": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "@azure/identity>@azure/msal-node": "7.1.1",
      "micromark-extension-math>katex": "0.18.2"
    }
  }
}
